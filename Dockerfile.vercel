# Stage 1: Build the React frontend
FROM node:22-alpine AS frontend-build

WORKDIR /app/client

COPY client/package*.json ./
RUN npm ci

COPY client/ ./

RUN npm run build


# Stage 2: Prepare the production server
FROM node:22-alpine AS production

WORKDIR /app

# Install the root project's production dependencies
COPY package*.json ./
RUN npm ci --omit=dev

# Copy the server and built frontend
COPY server.js ./server.js
COPY --from=frontend-build /app/client/dist ./client/dist

# Document the HTTP port
EXPOSE 80

# Start the Node.js HTTP server
CMD ["node", "server.js"]
